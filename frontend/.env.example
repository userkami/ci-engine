# ===== CI Frontend (Next.js 15) =====

# Auth.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_32_byte_random_string
INTERNAL_API_SECRET=replace_with_same_secret_as_backend
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret

# Admin API (optional; operator-only credit top-ups)
ADMIN_TOKEN=replace_with_same_token_as_backend
# Inside docker-compose this is http://backend:8000; local dev defaults below.
BACKEND_PROXY_URL=http://localhost:8000
